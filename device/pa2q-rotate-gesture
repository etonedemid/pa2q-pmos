#!/usr/bin/env python3
# Four-finger double tap on the touchscreen flips the screen between landscape
# and reverse landscape (from portrait it goes to landscape first).
#
# The accelerometer is not available yet (see README "Sensors"), so this is the
# manual rotation. Runs in the Plasma session (autostart): reads raw multitouch
# events from sec_touchscreen alongside kwin (no grab, apps still see the
# touches) and rotates with kscreen-doctor. Needs the user in the "input" group.
import glob
import json
import os
import struct
import subprocess
import time

TAP_MAX_S = 0.5       # all fingers down and up within this = one tap
DOUBLE_MAX_S = 0.6    # second tap must start within this after the first
FINGERS = 4

EV_SYN, EV_ABS = 0x00, 0x03
SYN_REPORT = 0
ABS_MT_SLOT, ABS_MT_TRACKING_ID = 0x2F, 0x39
EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit

# KScreen rotation enum -> kscreen-doctor name
LEFT, RIGHT = 2, 8


def touchscreen():
    for d in glob.glob("/sys/class/input/event*"):
        with open(d + "/device/name") as f:
            if f.read().strip() == "sec_touchscreen":
                return "/dev/input/" + os.path.basename(d)
    raise SystemExit("sec_touchscreen not found")


def flip():
    out = json.loads(subprocess.run(["kscreen-doctor", "-j"], capture_output=True,
                                    text=True, check=True).stdout)["outputs"]
    o = next(o for o in out if o["enabled"])
    to = "right" if o["rotation"] == LEFT else "left"
    subprocess.run(["kscreen-doctor", "output.%s.rotation.%s" % (o["name"], to)])


def main():
    fd = os.open(touchscreen(), os.O_RDONLY)
    slots, slot = set(), 0
    down_at, peak, last_tap = None, 0, 0.0
    while True:
        _, _, typ, code, val = EVENT.unpack(os.read(fd, EVENT.size))
        if typ == EV_ABS and code == ABS_MT_SLOT:
            slot = val
        elif typ == EV_ABS and code == ABS_MT_TRACKING_ID:
            (slots.discard if val < 0 else slots.add)(slot)
        elif typ == EV_SYN and code == SYN_REPORT:
            now = time.monotonic()
            if slots and down_at is None:
                down_at, peak = now, 0
            peak = max(peak, len(slots))
            if not slots and down_at is not None:
                is_tap = peak >= FINGERS and now - down_at <= TAP_MAX_S
                if is_tap and down_at - last_tap <= DOUBLE_MAX_S:
                    flip()
                    last_tap = 0.0
                elif is_tap:
                    last_tap = now
                down_at = None


if __name__ == "__main__":
    main()
