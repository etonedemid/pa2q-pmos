#!/bin/sh
# pa2q: Steam gaming mode - gamescope straight on the display (DRM backend),
# running Steam ARM's gamepad UI. Started by pa2q-session.
[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && exec dbus-run-session -- "$0" "$@"
# Keep this session's log across a hang/reboot (SDDM overwrites its own).
L=$HOME/.local/state/pa2q-gamescope.log
mkdir -p "${L%/*}" && mv -f "$L" "$L.prev" 2>/dev/null
exec >>"$L" 2>&1
# Steam's game runtime (pressure-vessel) and its CEF expect the session bus at
# $XDG_RUNTIME_DIR/bus; dbus-run-session puts it under /tmp. Without the link
# every Proton game quits at once ("bwrap: Can't find source path .../bus").
b=${DBUS_SESSION_BUS_ADDRESS#unix:path=}; b=${b%%,*}
[ -S "$b" ] && [ "$b" != "$XDG_RUNTIME_DIR/bus" ] && ln -sfn "$b" "$XDG_RUNTIME_DIR/bus"
# The phone has no working RTC: the clock reads 2026-09-04 until chrony syncs. Steam
# started before that fails TLS mid-update and is left unable to load its modules.
i=0
while [ "$(date +%s)" -lt 1790000000 ] && [ $i -lt 45 ]; do sleep 1; i=$((i + 1)); done
# Alpine starts PipeWire by hand; on systemd distros the user units already run it.
[ -x /usr/libexec/pipewire-launcher ] && /usr/libexec/pipewire-launcher >/dev/null 2>&1 &
/usr/local/bin/pa2q-keys &             # buttons and gestures, see that file
sudo -n /usr/local/bin/pa2q-touch-rotate on
# Dock: gamescope moves to the TV by itself, but keeps rendering at the phone's
# 1560x720 (letterboxed). Switch the game/UI size to the TV's preferred mode
# (Steam at the TV's full resolution; 720 lines made the UI blurry; per-game
# Game Resolution in Steam can still lower a heavy game) and back, and turn
# the touchscreen off while docked (sound follows in pa2q-speaker-bridge).
# ponytail: polls every 2 s, a udev hook if that ever matters.
(
	DP=/sys/class/drm/card0-DP-1 last=
	while sleep 2; do
		s=$(cat $DP/status)
		[ "$s" = "$last" ] && continue
		m=1560x720 t=undock
		[ "$s" = connected ] && m=$(head -n1 $DP/modes) t=dock
		sudo -n /usr/local/bin/pa2q-touch-rotate $t
		sleep 1   # gamescope picks the connector on the same uevent
		# 32cccc: four values (server, width, height, superres). "32c" set
		# only the first, so the size never changed.
		DISPLAY=:0 xprop -root -f GAMESCOPE_XWAYLAND_MODE_CONTROL 32cccc \
			-set GAMESCOPE_XWAYLAND_MODE_CONTROL "0,${m%x*},${m#*x},0" && last=$s
	done
) &
# Gamescope's Vulkan must report the display's DRM nodes (KGSL is not DRM);
# see turnip-kgsl-report-display-drm.patch. Xwayland GL: zink via kmsro.
export VK_DRIVER_FILES=/etc/vulkan/icd.d/freedreno_kgsl_drm_icd.json
export VK_ICD_FILENAMES=$VK_DRIVER_FILES
export TU_KGSL_DRM_RENDER=/dev/dri/renderD128 TU_KGSL_DRM_PRIMARY=/dev/dri/card0
export TU_DEBUG=nocb,sysmem MESA_LOADER_DRIVER_OVERRIDE=kmsro
# Games only get X11 here (Xwayland); pmOS's profile.d says wayland, which
# killed e.g. Hotline Miami's Qt launcher ("no platform plugin wayland").
export QT_QPA_PLATFORM=xcb GDK_BACKEND=x11
# Deck mode, as DroidDeck runs it. Without these flags Steam on ARM64 takes itself
# for a Steam Frame: its setup wants Frame controllers and VR.
export STEAM_GAMESCOPE_NIS_SUPPORTED=1 STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT=1
export STEAM_ARM_DEVICE=${STEAM_ARM_DEVICE:--steamdeck}
# Steam otherwise asks gamescope for 120 Hz a minute in; the phone reset right
# after that modeset (2026-11-05). Keep it at the rate gamescope starts with.
export STEAM_DISPLAY_REFRESH_LIMITS=${PA2Q_GAMESCOPE_HZ:-60},${PA2Q_GAMESCOPE_HZ:-60}
# -usepipewireaudio: Steam's PipeWire audio manager. Without it the client
# picks its "default" manager: the volume popup shows, the volume never changes.
# Panel is 1440x3120 portrait. -W/-H pick its 1080x2340 mode for the output
# (portrait numbers: gamescope matches the mode before rotation);
# games still render at 1560x720 and are scaled up.
# 60 Hz: with compositor rotation gamescope composites every frame of the
# full panel; at the panel's 120 Hz that is twice the GPU work and heat for
# games that mostly run at 60 anyway. PA2Q_GAMESCOPE_HZ=120 to override.
# Rotate in the compositor: SDE's inline rotator takes at most 1088 lines and
# rejects the panel's 1440 ("invalid height for inline rot"), so every
# scanout-rotated commit failed with EINVAL (black screen).
gamescope --backend drm -e --force-orientation "${PA2Q_GAMESCOPE_ORIENTATION:-left}" \
	--force-composition-rotation \
	-r "${PA2Q_GAMESCOPE_HZ:-60}" \
	-W 1080 -H 2340 -w 1560 -h 720 --default-touch-mode 4 \
	-- /usr/local/bin/steam-arm -gamepadui -steamdeck -steamos3 \
	-clientbeta steamdeck_publicbeta -no-cef-sandbox -usepipewireaudio
sudo -n /usr/local/bin/pa2q-touch-rotate off
kill $(jobs -p) 2>/dev/null
