+/* The KGSL backend cannot round-trip a UBWC-compressed dmabuf. Buffers exported
+ * with DRM_FORMAT_MOD_QCOM_COMPRESSED fail to import again, so as soon as a
+ * client shares one with a compositor the import fails and the client is
+ * disconnected:
+ *
+ *    wlr_linux_dmabuf_v1: Failed to import DMA-BUF FD for plane 0: Invalid argument
+ *
+ * On a device where the GPU is reachable only through /dev/kgsl (no DRM node for
+ * the Adreno at all) that breaks every client using the dmabuf path - browsers
+ * in particular, which render in a separate GPU process. Advertise LINEAR only
+ * there, so the modifier negotiation settles on something that imports.
+ *
+ * The DRM/msm backend is unaffected and keeps UBWC.
+ */
+static bool
+tu_modifier_ubwc_shareable(const struct tu_physical_device *physical_device)
+{
+   return strcmp(physical_device->instance->knl->name, "kgsl") != 0;
+}
